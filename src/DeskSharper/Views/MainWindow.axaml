<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskSharper.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="DeskSharper.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/desksharper.png"
        Title="DeskSharper - Desktop Cleaner"
        Width="900" Height="700"
        MinWidth="700" MinHeight="550">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🧹 DeskSharper - Desktop Cleaner"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,10" />
            <TextBlock Text="Organize your desktop automatically"
                       FontSize="14"
                       Opacity="0.7" />
        </StackPanel>

        <!-- Main Content with Tabs -->
        <TabControl Grid.Row="1">
            <!-- Main Tab -->
            <TabItem Header="Main">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Scrollable Content -->
                    <ScrollViewer Grid.Row="0">
                        <StackPanel Spacing="15">

                            <!-- Configuration Selection -->
                            <Border BorderBrush="{DynamicResource SystemAccentColor}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="15">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Configuration" FontSize="16" FontWeight="SemiBold" />

                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding ConfigNames}"
                                                  SelectedItem="{Binding SelectedConfigName}"
                                                  PlaceholderText="Select a configuration..."
                                                  VerticalContentAlignment="Center"
                                                  Margin="0,0,10,0" />
                                        <Button Grid.Column="1"
                                                Content="Load"
                                                Command="{Binding LoadConfigCommand}"
                                                Margin="0,0,10,0"
                                                Padding="15,8" />
                                        <Button Grid.Column="2"
                                                Content="Delete"
                                                Command="{Binding DeleteConfigCommand}"
                                                Margin="0,0,10,0"
                                                Padding="15,8" />
                                        <Button Grid.Column="3"
                                                Content="New"
                                                Command="{Binding NewConfigCommand}"
                                                Padding="15,8" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Config Name:" VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding ConfigName}"
                                                 Watermark="Enter configuration name..."
                                                 VerticalContentAlignment="Center"
                                                 Margin="0,0,10,0" />
                                        <Button Grid.Column="2"
                                                Content="💾 Save Config"
                                                Command="{Binding SaveConfigCommand}"
                                                Padding="15,8" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Paths -->
                            <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="8" Padding="15">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Paths" FontSize="16" FontWeight="SemiBold" />

                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Source Path:" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"
                                                   Width="110" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding SourcePath}"
                                                 VerticalContentAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 IsReadOnly="True" />
                                        <Button Grid.Column="2"
                                                Content="Browse..."
                                                Command="{Binding BrowseSourcePathCommand}"
                                                Padding="15,8" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Destination:" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"
                                                   Width="110" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding DestinationPath}"
                                                 Watermark="Leave empty to delete items..."
                                                 VerticalContentAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 IsReadOnly="True" />
                                        <Button Grid.Column="2"
                                                Content="Browse..."
                                                Command="{Binding BrowseDestinationPathCommand}"
                                                Padding="15,8" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Move Options -->
                            <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="8" Padding="15">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Move Options" FontSize="16" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="20">
                                        <CheckBox Content="Move Folders" IsChecked="{Binding MoveFolders}" />
                                        <CheckBox Content="Move Shortcuts" IsChecked="{Binding MoveShortcuts}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Advanced Options - Now Expanded by Default -->
                            <Expander Header="Advanced Options" IsExpanded="True">
                                <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="8" Padding="15"
                                        Margin="0,5,0,0">
                                    <StackPanel Spacing="15">

                                        <!-- Keep Files -->
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="Keep Files (comma-separated):" FontWeight="SemiBold" />
                                            <TextBox Text="{Binding KeepFilesText}"
                                                     Watermark="e.g., important.txt, config.ini"
                                                     VerticalContentAlignment="Center"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="False" />
                                        </StackPanel>

                                        <!-- Keep Extensions -->
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="Keep Extensions (comma-separated):" FontWeight="SemiBold" />
                                            <TextBox Text="{Binding KeepExtensionsText}"
                                                     Watermark="e.g., .txt, .pdf, .docx"
                                                     VerticalContentAlignment="Center"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="False" />
                                        </StackPanel>

                                        <!-- Retention Time -->
                                        <Grid ColumnDefinitions="Auto,200,*">
                                            <TextBlock Grid.Column="0" Text="Retention Time (hours):"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0" />
                                            <NumericUpDown Grid.Column="1"
                                                           Value="{Binding RetentionHours}"
                                                           Minimum="0"
                                                           Maximum="8760"
                                                           Increment="1" />
                                            <TextBlock Grid.Column="2"
                                                       Text="(0 = process all items)"
                                                       VerticalAlignment="Center"
                                                       Opacity="0.7"
                                                       Margin="10,0,0,0" />
                                        </Grid>

                                        <!-- Check Mode -->
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="Time Check Mode:" FontWeight="SemiBold" />
                                            <ComboBox SelectedIndex="{Binding CheckModeIndex}"
                                                      VerticalContentAlignment="Center"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="Last Modified Time" />
                                                <ComboBoxItem Content="Last Accessed Time" />
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Expander>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                                Margin="0,15,0,0">
                        <Button Content="👁️ Preview"
                                Command="{Binding PreviewCommand}"
                                IsEnabled="{Binding !IsProcessing}"
                                Padding="20,10"
                                FontSize="14" />
                        <Button Content="▶️ Run Cleaning"
                                Command="{Binding RunCommand}"
                                IsEnabled="{Binding !IsProcessing}"
                                Padding="20,10"
                                FontSize="14">
                            <Button.Classes>accent</Button.Classes>
                        </Button>
                    </StackPanel>

                    <!-- Preview/Status Area -->
                    <Border Grid.Row="2"
                            Background="#20808080"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,15,0,0"
                            MinHeight="120"
                            IsVisible="{Binding HasPreviewOrStatus}">
                        <ScrollViewer MaxHeight="200">
                            <StackPanel Spacing="8">
                                <!-- Processing Status -->
                                <StackPanel Spacing="5" IsVisible="{Binding IsProcessing}">
                                    <ProgressBar IsIndeterminate="True" Height="4" />
                                    <TextBlock Text="{Binding StatusMessage}"
                                               FontWeight="SemiBold" />
                                </StackPanel>

                                <!-- Preview Results -->
                                <StackPanel Spacing="8" IsVisible="{Binding HasPreviewResults}">
                                    <TextBlock FontWeight="Bold" FontSize="14">
                                        <Run Text="扫描结果" />
                                        <Run Text=" / " />
                                        <Run Text="Scan Results" />
                                    </TextBlock>

                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                                          ColumnSpacing="10"
                                          RowSpacing="5">
                                        <!-- Scan Time -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="扫描耗时 / Scan Time:"
                                                   Opacity="0.8" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PreviewScanTime}"
                                                   FontWeight="SemiBold" />

                                        <!-- Items Found -->
                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="找到需要移动的项目 / Items to Move:"
                                                   Opacity="0.8" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PreviewItemCount}"
                                                   FontWeight="SemiBold" />

                                        <!-- Source Path -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="源路径 / Source Path:"
                                                   Opacity="0.8" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SourcePath}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Destination -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="移动到 / Move To:" Opacity="0.8" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PreviewDestination}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <!-- Item List -->
                                    <StackPanel Spacing="5">
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="下面的项目将被移动" />
                                            <Run Text=" / " />
                                            <Run Text="Items to be Moved:" />
                                        </TextBlock>
                                        <Border BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="4"
                                                Padding="10"
                                                Background="#10000000">
                                            <TextBlock Text="{Binding PreviewItemList}"
                                                       TextWrapping="Wrap"
                                                       FontFamily="Consolas, monospace"
                                                       FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Simple Status Message -->
                                <TextBlock Text="{Binding StatusMessage}"
                                           IsVisible="{Binding !HasPreviewResults}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="Settings">
                <ScrollViewer>
                    <StackPanel Spacing="20" Margin="20">
                        <TextBlock Text="Application Settings"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10" />

                        <!-- Startup Settings -->
                        <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Startup Options" FontSize="16" FontWeight="SemiBold" />
                                <CheckBox Content="Run automatically on startup (开机自动运行)"
                                          IsChecked="{Binding AutoRun}" />
                                <TextBlock
                                    Text="Enable this to automatically clean your desktop when the system starts."
                                    Opacity="0.7"
                                    TextWrapping="Wrap"
                                    FontSize="12" />
                            </StackPanel>
                        </Border>

                        <!-- Language Settings -->
                        <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Language / 语言" FontSize="16" FontWeight="SemiBold" />
                                <ComboBox SelectedIndex="{Binding LanguageIndex}"
                                          VerticalContentAlignment="Center"
                                          HorizontalAlignment="Left"
                                          MinWidth="200">
                                    <ComboBoxItem Content="English" />
                                    <ComboBoxItem Content="中文 (Chinese)" />
                                </ComboBox>
                                <TextBlock
                                    Text="Application restart may be required for language changes to take full effect."
                                    Opacity="0.7"
                                    TextWrapping="Wrap"
                                    FontSize="12" />
                            </StackPanel>
                        </Border>

                        <!-- About / Help -->
                        <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="About / Help" FontSize="16" FontWeight="SemiBold" />

                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold">DeskSharper - Desktop Cleaner</TextBlock>
                                    <TextBlock Text="Version: 1.0.0" Opacity="0.8" />
                                    <TextBlock Text="A cross-platform desktop organizer" Opacity="0.8" />
                                    <TextBlock Text="© 2025 DeskSharper" Opacity="0.8" />
                                </StackPanel>

                                <Separator Margin="0,10" />

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Help &amp; Documentation" FontWeight="SemiBold" />
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="• Select a source path to monitor (usually Desktop)"
                                                   Opacity="0.8" />
                                        <TextBlock Text="• Set a destination path or leave empty to delete items"
                                                   Opacity="0.8" />
                                        <TextBlock Text="• Configure retention time to keep recent files"
                                                   Opacity="0.8" />
                                        <TextBlock Text="• Use whitelist to protect important files"
                                                   Opacity="0.8" />
                                        <TextBlock Text="• Save configurations for reuse" Opacity="0.8" />
                                    </StackPanel>
                                </StackPanel>

                                <Separator Margin="0,10" />

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Support" FontWeight="SemiBold" />
                                    <TextBlock Text="For issues and feature requests, please visit:" Opacity="0.8" />
                                    <TextBlock Text="https://github.com/hnrobert/desksharper"
                                               Foreground="{DynamicResource SystemAccentColor}"
                                               Cursor="Hand" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>

</Window>